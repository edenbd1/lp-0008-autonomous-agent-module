target/
.demo*/
*.mov
*.mp4
artifacts/e2e/dist*/
.DS_Store
build/
build/

# Agent wallet homes never belong in the repository.
artifacts/agents/

# Which local account anchors which agent. Per-operator state, deliberately not
# committed: `deploy-agents.sh` reads this file to resume a run with the same
# owner, so shipping the author's ids in it would make every stranger's run
# resolve three accounts their wallet cannot sign for — which is the bug this
# file exists to stop repeating. The owners of the deployment this repository
# publishes are in artifacts/agents.tsv, as evidence rather than as input.
artifacts/signers.tsv
_external/
build-basecamp/
# The linux-amd64 build tree, from the container build in docs/basecamp.md.
build-linux/
build-linux-arm64/
build-ui-linux/
build-ui-arm64/
# scripts/logos-core-headless.sh builds the headless harness and keeps the
# module's persistence base here.
build-headless/

build-ui/
app/src/metadata.json

# The delivery-linked build tree: `cmake -S module -B build-delivery
# -DLOGOS_DELIVERY_ROOT=...`, which stages a 40 MB library beside the plugin.
build-delivery/

# scripts/build-companion-modules.sh: the upstream wallet/storage/messaging
# checkouts, their build trees, the .lgx packages, and the isolated modules
# directory `logos-core-headless.sh --alongside` installs all four into.
build-companions/

# Byte-compiled Python, from scripts that import each other rather than
# duplicating a definition (write-package-record.py loads check-package-fresh.py).
__pycache__/

# The submission working draft, kept OUT of the repository on purpose.
#
# It is a build input, not a deliverable: 159 KB of draft that lived at the top
# level of a public tree, against the criterion asking for a clean public
# repository. Its evidence sections are generated by
# scripts/submission-evidence.py, which takes the path as an argument and
# assumes nothing about where the draft lives; CI renders those sections with no
# file at all and checks them against the chain. What ships is the PR body and
# solutions/LP-0008.md.
SUBMISSION-DRAFT.md
